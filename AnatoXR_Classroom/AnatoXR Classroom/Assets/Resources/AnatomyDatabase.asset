    fmaPreferredName: 
  - partName: Radius.l
    systemName: Skeletal System
    partType: Long Bone
    description: "The radius is the lateral, mobile long bone of the forearm (aligned with the thumb). It has a cylindrical disc-shaped head, neck, prominent bicipital tuberosity, an interosseous crest, and an expanded distal base with a styloid process."
    function: "Pivots around the stationary ulna to enable forearm pronation and supination; receives and distributes mechanical impact forces from the hand via the radiocarpal wrist joint."
    location: "Positioned on the lateral side of the forearm parallel to the ulna, articulating with the humeral capitulum, radial notch of the ulna, scaphoid, and lunate."
    fmaId: 
    fmaPreferredName: 
  - partName: Radius.r
    systemName: Skeletal System
    partType: Long Bone
    description: "The radius is the lateral, mobile long bone of the forearm (aligned with the thumb). It has a cylindrical disc-shaped head, neck, prominent bicipital tuberosity, an interosseous crest, and an expanded distal base with a styloid process."
    function: "Pivots around the stationary ulna to enable forearm pronation and supination; receives and distributes mechanical impact forces from the hand via the radiocarpal wrist joint."
    location: "Positioned on the lateral side of the forearm parallel to the ulna, articulating with the humeral capitulum, radial notch of the ulna, scaphoid, and lunate."
    fmaId: 
    fmaPreferredName: 
  - partName: Sacrum
    systemName: Skeletal System
    partType: Irregular Bone
    description: "A rigid skeletal organ (Sacrum) constructed from an outer dense cortical bone layer, internal spongy trabecular cancellous bone, periosteum, and bone marrow."
    function: "Provides structural body scaffolding, mechanical lever arms for muscle action, hematopoiesis (blood cell production), and a systemic metabolic reservoir for calcium and phosphate."
    location: "Constitutes an integral part of the skeletal framework in the pelvic cavity and perineal region. Midline anatomical structure on the central body axis."
    fmaId: "http://purl.org/sig/ont/fma/fma16202"
    fmaPreferredName: Sacrum
  - partName: Scaphoid bone.l
    systemName: Skeletal System
    partType: Bone
    description: "A rigid skeletal organ (Scaphoid bone) constructed from an outer dense cortical bone layer, internal spongy trabecular cancellous bone, periosteum, and bone marrow."
    function: "Provides structural body scaffolding, mechanical lever arms for muscle action, hematopoiesis (blood cell production), and a systemic metabolic reservoir for calcium and phosphate."
    location: "Constitutes an integral part of the skeletal framework in the wrist (carpal region). Left side (bilateral structure)."
    fmaId: 
    fmaPreferredName: 
  - partName: Scaphoid bone.r
    systemName: Skeletal System
    partType: Bone
    description: "A rigid skeletal organ (Scaphoid bone) constructed from an outer dense cortical bone layer, internal spongy trabecular cancellous bone, periosteum, and bone marrow."
