    fmaId: 
    fmaPreferredName: 
  - partName: (Iliopectineal bursa).l
    systemName: Joints & Articulations
    partType: Synovial Bursa
    description: "An articulated junction (Iliopectineal bursa) where adjacent skeletal elements meet, lined with smooth articular hyaline cartilage and enclosed by a synovial fluid-filled capsule."
    function: "Permits controlled mechanical degrees of freedom (flexion, extension, rotation, or gliding) while distributing biomechanical compressive loads."
    location: "Positioned between articulating bones in the human body. Left side (bilateral structure)."
    fmaId: 
    fmaPreferredName: 
