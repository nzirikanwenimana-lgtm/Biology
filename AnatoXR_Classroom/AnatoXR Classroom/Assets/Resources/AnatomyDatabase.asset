    fmaId: "http://purl.org/sig/ont/fma/fma20229"
    fmaPreferredName: Coccyx
  - partName: Corniculate cartilage.l
    systemName: Joints & Articulations
    partType: Cartilaginous Structure
    description: "An articulated junction (Corniculate cartilage) where adjacent skeletal elements meet, lined with smooth articular hyaline cartilage and enclosed by a synovial fluid-filled capsule."
    function: "Permits controlled mechanical degrees of freedom (flexion, extension, rotation, or gliding) while distributing biomechanical compressive loads."
    location: "Positioned between articulating bones in the human body. Left side (bilateral structure)."
    fmaId: 
    fmaPreferredName: 
